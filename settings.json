{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title \"Claude Code\" -subtitle \"$(pwd)\" -message \"Execution has finished!\" -sound Boop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/pforret/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "dev-browser@dev-browser-marketplace": true,
    "document-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "banana-claude@banana-claude-marketplace": true,
    "swift-lsp@claude-plugins-official": true,
    "screenshot-web@cli-skills": true,
    "screenshot-desktop@cli-skills": true,
    "markdown-web@cli-skills": true,
    "markdown-file@cli-skills": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "banana-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/banana-claude"
      }
    },
    "cli-skills": {
      "source": {
        "source": "github",
        "repo": "pforret/cli-skills"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "low",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "model": "claude-fable-5[1m]"
}
